# Backend
UPTIME_ADDR=:8080
UPTIME_DB_PATH=uptime.db
# UPTIME_API_TOKEN=change-me
# The token /metrics asks for as a bearer token; unset, /metrics is open to anyone who can reach the port.
# UPTIME_METRICS_TOKEN=
# Required: encrypts tokens and passwords in the database. 32 random characters
# or more: openssl rand -base64 36. Keep a copy with the backups: a database is
# of no use without the key its secrets were encrypted with.
UPTIME_SECRET_KEY=
# ...or the key read from a file, such as a mounted Secret; set one of the two.
# For installs without the Helm chart, which sets UPTIME_SECRET_KEY itself.
# The file is used byte for byte, like the variable: a trailing newline is part
# of the key, and the same text without it is another key. Write the file
# without one: openssl rand -base64 36 | tr -d '\n' > key
# UPTIME_SECRET_KEY_FILE=/etc/kubeat/secret-key/key
# Without a key the backend does not start, unless this stores the secrets
# unencrypted instead.
# UPTIME_ALLOW_PLAINTEXT_SECRETS=false
# Accounts: the first administrator ("admin") is created from this when there
# is no account. Leave it unset to create the administrator at /setup on the
# first visit; otherwise use a long random value (openssl rand -base64 24). A
# password that breaks the password rules stops the backend from starting.
# UPTIME_ADMIN_PASSWORD=
# UPTIME_ADMIN_PASSWORD_RESET=false
UPTIME_SESSION_TTL=12h
# Sign-in throttle, keyed per source address + name, so one source's guesses
# do not lock a name out for everyone (CWE-307, docs/adr/0004-...). MAX_FAILURES
# is per source; ACCOUNT_MAX_FAILURES is a loose, very high ceiling across all
# sources (0 turns it off, leaving only the per-source throttle). The same two
# guard a status page's password and the current password asked for to change
# one, per source and page or account. With LDAP keep MAX_FAILURES below the
# directory's lockout threshold (README "LDAP").
UPTIME_LOGIN_MAX_FAILURES=10
UPTIME_LOGIN_ACCOUNT_MAX_FAILURES=50
# A ceiling on one source's failed sign-ins across all names (a password
# spray, with LDAP a bind each); 0 (the default) turns it off, since the users
# behind one NAT or PAC proxy share a source. 20 for a directory install
# reachable from the internet (README "LDAP"). With LDAP and this left unset
# the backend warns at start; 0 given on purpose is only noted. Set the proxy
# hops below first: with 0, or without the UI token, every browser is the UI
# pod and the ceiling becomes one lock for all sign-ins (warned at start).
# UPTIME_LOGIN_SOURCE_MAX_FAILURES=0
# The X-Forwarded-For entries your proxies in front of the UI write, which the
# UI passes on with the browser's sign-in (1 with no proxy and the UI reached
# only by a port-forward or locally: Next.js writes its own peer, but keeps a
# header a client sent; the values per topology are in README "Hesaplar ve
# giriş"): the
# source is read from the rightmost this many. 0 trusts no such header and uses
# the peer, the UI for every browser; behind a Route or ingress set it, or the
# throttle sees one shared address for every client and falls back to one
# per-name lock. A misconfigured
# value is warned (rate-limited): an X-Forwarded-For seen while this is 0, a
# sign-in from a peer other than the UI, and a chain shorter than the hops (the
# last two safely fall back to the peer). But too high behind a proxy that
# appends (Route, GCLB), a client lengthening the header picks its source,
# unwarned: if unsure, take the lower value.
UPTIME_TRUST_PROXY_HOPS=0
# The secret the UI presents with every request (X-Frontend-Token, from its
# FRONTEND_TOKEN below): X-Forwarded-For is read only from a request that
# carries it, so a pod that reaches the backend directly keys on its own
# address. Set both to the same random value while UPTIME_TRUST_PROXY_HOPS is
# above 0 (openssl rand -hex 24; printable ASCII without spaces), or the
# header is trusted from no peer and the start warns. The chart sets both from
# <release>-frontend-token.
# UPTIME_FRONTEND_TOKEN=
UPTIME_LOGIN_LOCKOUT=15m
# The most usernames that are not locked the sign-in throttle tracks (locked
# ones are kept beyond it), and SSO sign-ins under way the backend keeps
# (past it the oldest are forgotten).
UPTIME_LOGIN_THROTTLE_MAX_KEYS=100000
# bcrypt comparisons at once; 0 is half the CPUs, at least 1, or 2 with LDAP
# (every directory sign-in takes one too). Directory binds have a queue of
# their own (16 at once).
UPTIME_LOGIN_CONCURRENCY=0
UPTIME_LOGIN_QUEUE_WAIT=3s
# Failed sign-ins of names without an account written to the audit log a
# minute; since 0.52 also the target-scope refusals (deny/target-scope rows and
# their WARN lines), the API's and the checks' each under a cap of its own.
# The counters count every one. Must be at least 1: 0 or less keeps the
# backend from starting (invalid configuration).
UPTIME_LOGIN_AUDIT_PER_MINUTE=60
UPTIME_PASSWORD_MIN_LENGTH=8
UPTIME_AUDIT_RETENTION=2160h
# LDAP sign-in; off while the URL is empty
# UPTIME_LDAP_URL=ldaps://ldap.example.com:636
# UPTIME_LDAP_BASE_DN=dc=example,dc=com
# UPTIME_LDAP_USER_FILTER=(uid={username})
# UPTIME_LDAP_BIND_DN=cn=svc-kubeat,ou=svcaccts,dc=example,dc=com
# UPTIME_LDAP_BIND_PASSWORD=
# UPTIME_LDAP_START_TLS=false
# UPTIME_LDAP_CA_FILE=
# UPTIME_LDAP_INSECURE_SKIP_VERIFY=false
# UPTIME_LDAP_DISPLAY_NAME_ATTR=cn
# UPTIME_LDAP_EMAIL_ATTR=mail
# UPTIME_LDAP_GROUP_ATTR=memberOf
# UPTIME_LDAP_GROUP_BASE_DN=
# UPTIME_LDAP_GROUP_FILTER=
# UPTIME_LDAP_TIMEOUT=10s
# UPTIME_LDAP_DEFAULT_ROLE=
# UPTIME_LDAP_DEFAULT_NAMESPACES=
# UPTIME_OIDC_ISSUER=https://sso.example.com/realms/corp
# UPTIME_OIDC_CLIENT_ID=kubeat
# UPTIME_OIDC_CLIENT_SECRET=
# UPTIME_OIDC_REDIRECT_URL=http://localhost:3000/auth/callback
UPTIME_OIDC_SCOPES=openid profile email
UPTIME_OIDC_GROUPS_CLAIM=groups
UPTIME_OIDC_NAME=SSO
UPTIME_DB_BUSY_TIMEOUT=5s
UPTIME_READ_HEADER_TIMEOUT=5s
UPTIME_HTTP_READ_TIMEOUT=30s
UPTIME_HTTP_WRITE_TIMEOUT=2m
UPTIME_HTTP_IDLE_TIMEOUT=2m
UPTIME_HTTP_MAX_HEADER_BYTES=1048576
# How long stopping waits for open requests and for the notifications still
# waiting; the outages among what is not sent by then go at the next start.
# The pod's grace period (the chart's backend.terminationGracePeriodSeconds,
# 30) must be at least 5s longer.
UPTIME_SHUTDOWN_TIMEOUT=10s
UPTIME_SCHEDULER_TICK=1s
UPTIME_MAX_JITTER=5s
UPTIME_WORKERS=20
UPTIME_RESULT_BATCH_SIZE=100
UPTIME_RESULT_FLUSH_INTERVAL=1s
UPTIME_RETENTION=168h
UPTIME_RETENTION_INTERVAL=1h
UPTIME_ROLLUP_INTERVAL=1m
UPTIME_ROLLUP_RETENTION=8760h
# How long the delivery log is kept: what was sent to which channel about each
# incident, shown on the incident's page. The incidents themselves stay.
UPTIME_DELIVERY_RETENTION=8760h
# Failed checks, and separately notifications, an incident's page shows at most;
# of more, the first and the last halves. At least 2.
UPTIME_INCIDENT_TIMELINE_LIMIT=100
UPTIME_SERIES_POINTS=120
UPTIME_HTTP_INSECURE_SKIP_VERIFY=false
UPTIME_KEYWORD_BODY_LIMIT_BYTES=1048576
# A JSON check repeats the value it found in its result and error; set false
# where a target's response may hold data the monitor's viewers should not see.
UPTIME_CHECK_SHOW_VALUE=true
# Where checks and notifications may connect (comma-separated CIDRs). Loopback,
# link-local (cloud metadata) and multicast are always denied unless allowed here;
# private ranges, where ClusterIPs and pod IPs are, are not denied unless listed.
# UPTIME_TARGET_DENY_CIDRS=10.0.0.0/8
# Local development: let checks reach services on this machine.
# UPTIME_TARGET_ALLOW_CIDRS=127.0.0.0/8,::1/128
# Timeout of the name lookup the per-user scope check makes in the API when a
# scoped user aims a monitor or webhook at an external-looking name; a name not
# resolved in time is refused on the safe side and counted as resolve_error.
# Keep it below BACKEND_TIMEOUT_MS (3s). A check's own lookups are bounded by
# the monitor's timeout, not by this (README, "Hedef politikası" → "Zaman aşımı").
UPTIME_TARGET_RESOLVE_TIMEOUT=2s
# Behind HTTP_PROXY/HTTPS_PROXY outside the cluster, where only the proxy resolves
# external names: true lets a scoped user's proxied HTTP/WebSocket monitor or
# webhook through when its name is NXDOMAIN here (NO_PROXY decides what is
# proxied). A name resolving into the cluster, a SERVFAIL and a timeout are still
# refused. Never true for a proxy inside the cluster (README, "Vekilli kurulum").
UPTIME_TARGET_SCOPE_TRUST_PROXY=false
# The company's own ranges, private but outside the cluster: for the per-user
# scope check an address in them, bare or resolved from a name, counts as
# outside the cluster, so a scoped user may aim a monitor or webhook at it
# (comma-separated CIDRs, empty by default; the target policy does not read
# them). Never list the cluster's pod, Service or node (machine) networks or
# its API VIP. Add the router's VIP only on purpose, for on-prem Routes, as a
# /32 when it is in the node network: every Route behind it, other teams' too,
# then opens to scoped users. An entry that is not a CIDR, or an IPv4 range
# written as IPv6, stops the start. A range over a network of
# UPTIME_TARGET_SCOPE_CLUSTER_CIDRS, or holding the API server's address or the
# backend's own (as after a drain moved the pod), does not: it alone is
# ignored, said by an ERROR at start, kubeat_target_scope_external_ranges_ignored
# and the KubeatScopeExternalRangesIgnored rule (README, "Hedef politikası").
# UPTIME_TARGET_SCOPE_EXTERNAL_CIDRS=10.50.0.0/16
# The cluster's own pod, Service and node networks (comma-separated CIDRs,
# empty by default), declared so that the start ignores a company range above
# that overlaps any part of one, IPv4 or IPv6; a single address (/32, /128),
# the router's VIP in the node network, is not compared. The scope check does
# not read them. An entry that is not a CIDR, or an IPv4 network written as
# IPv6, stops the start. The chart gives them from targetScope.clusterNetworks
# and refuses an IPv4 overlap when it renders (README, "Kurum ağı", "Cluster
# ağlarının beyanı").
# UPTIME_TARGET_SCOPE_CLUSTER_CIDRS=10.128.0.0/14,172.30.0.0/16,192.168.40.0/24
UPTIME_MIN_CHECK_INTERVAL=5s
# Guardrails against monitors putting load on other systems (README, "Hedef
# yükü"). A target is in-cluster when its host is a private address, a *.svc or
# *.cluster.local name or a name without a dot; everything else is external. In
# each, 0 turns the limit off.
# The shortest interval (and retry interval) of a monitor with an external
# target; at least UPTIME_MIN_CHECK_INTERVAL.
UPTIME_MIN_CHECK_INTERVAL_EXTERNAL=30s
# Checks a minute one external host name, and one in-cluster host name, gets
# from all monitors together; a check due past that waits for a later tick.
UPTIME_TARGET_MAX_RATE=60
UPTIME_CLUSTER_TARGET_MAX_RATE=600
# Checks a minute one IP address gets from the checks of every name that
# reaches it, whatever the address's class: the hosts behind one ingress or
# router address share it (300 monitors at 30s). 0 turns the address bucket off.
UPTIME_TARGET_ADDRESS_MAX_RATE=600
# How many monitors may check one external host.
UPTIME_MAX_MONITORS_PER_HOST=5
# How many monitors may exist, in all and in one namespace; bound when one is
# created, monitors above a limit keep running.
UPTIME_MAX_MONITORS=1000
UPTIME_MAX_MONITORS_PER_NAMESPACE=200
# How many monitors one account (the API token counts as one) may create in a
# minute; more get 429, and the audit log one entry per minute.
UPTIME_MONITOR_CREATE_PER_MINUTE=30
# What checks and notifications send as User-Agent; empty means
# "kubeat/<version> (+https://github.com/yusufceng/Kubeat; <UPTIME_PUBLIC_URL>)".
# UPTIME_USER_AGENT=
UPTIME_STATS_WINDOW=24h
UPTIME_MAX_RESULTS=1000
UPTIME_STATUS_PAGE_DAYS=90
UPTIME_STATUS_PAGE_INCIDENT_WINDOW=336h
# How many updates a status page lists, how far ahead it lists maintenance
# windows, how far back a monitor's detail page draws response times, and how
# long a visitor's password stays good for a protected page.
UPTIME_STATUS_PAGE_UPDATES=20
UPTIME_STATUS_PAGE_UPCOMING=168h
UPTIME_STATUS_PAGE_SERIES=24h
UPTIME_STATUS_PAGE_SESSION=12h
UPTIME_DEFAULT_FAILURE_THRESHOLD=3
UPTIME_RECOVERY_THRESHOLD=1
UPTIME_CERT_WARNING=336h
UPTIME_REMINDER_INTERVAL=0
UPTIME_NOTIFY_ATTEMPTS=3
UPTIME_NOTIFY_RETRY_DELAY=5s
UPTIME_NOTIFY_TIMEOUT=5s
# Notifications waiting for delivery; one that finds the queue full is
# dropped. At least the number of monitors, so that an outage of all of
# them fits: the default is UPTIME_MAX_MONITORS's, and the backend warns
# once when more monitors are enabled. 1000 take about 1 MiB of memory.
UPTIME_NOTIFY_QUEUE_SIZE=1000
# An outage notification a channel did not take is sent again while the
# outage lasts: after 1, 2, 4... minutes up to RETRY_MAX when it did not
# reach the channel (no answer, timeout, 5xx), RETRY_MAX later when the
# receiver refused it (4xx), at its Retry-After (RETRY_MAX at most) when it
# was busy (429) ("0" turns it off; a RETRY_MAX under 1m or one attempt,
# ATTEMPTS x (TIMEOUT + RETRY_DELAY), is raised to that, and the backend
# logs a WARN with both values); the end of an outage for RETRY_FOR at most
# ("0" does not send it again). Only a failure without an answer, a timeout
# or a 5xx is tried again ATTEMPTS times within an attempt.
UPTIME_NOTIFY_RETRY_MAX=15m
# A shorter cap than RETRY_MAX for the channels people read (Slack, Teams,
# e-mail, Telegram...): their back-off doubles to this at most and waits out
# a refusal for it, while webhook and PagerDuty keep RETRY_MAX, so a stale
# page does not reach a chat long after the outage. "0" (the default) leaves
# them on RETRY_MAX (unchanged behaviour); it does not turn retries off (that
# is RETRY_MAX=0). Same floor as RETRY_MAX; a shorter value is raised to it
# with a WARN. Set it to 2-5m when a human channel is an on-call team's main
# channel.
UPTIME_NOTIFY_HUMAN_RETRY_MAX=0
UPTIME_NOTIFY_RETRY_FOR=1h
UPTIME_NOTIFY_GROUP_WAIT=30s
UPTIME_LANGUAGE=en
# Where users reach Kubeat, for the links in notifications. Its host is also
# resolved at start and every 5 minutes: a sign-in keyed on one of its
# addresses was keyed on the load balancer in front of the UI, which the
# backend warns of and counts as hops_too_low (UPTIME_TRUST_PROXY_HOPS too
# low). A CNAME or a host that does not resolve keeps that check quiet.
# UPTIME_PUBLIC_URL=https://kubeat.apps.example
# The name of this installation in its notifications, for receivers several
# share: PagerDuty's dedup key and custom details, the webhook body, the
# footer of Slack and Mattermost, Teams and Google Chat cards, the e-mail's
# body. Empty takes UPTIME_PUBLIC_URL's host; with neither there is none.
# Close the open PagerDuty incidents before changing it or the public URL.
# UPTIME_INSTANCE_NAME=prod-eu
UPTIME_DISCOVERY_ENABLED=true
# UPTIME_DISCOVERY_NAMESPACES=shop,billing
UPTIME_DISCOVERY_SYNC_INTERVAL=1m
UPTIME_DISCOVERY_DEFAULT_INTERVAL=30s
UPTIME_DISCOVERY_DEFAULT_TIMEOUT=5s
# UPTIME_KUBECONFIG=/home/me/.kube/config
# UPTIME_KUBE_CONTEXT=minikube
UPTIME_KUBE_TIMEOUT=10s
UPTIME_EVENT_WINDOW=2h
UPTIME_EVENT_LIMIT=20
UPTIME_WORKLOAD_ROLLOUT_GRACE=10m
# UPTIME_PROMETHEUS_URL=https://thanos-querier.openshift-monitoring.svc:9091
# UPTIME_PROMETHEUS_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# UPTIME_PROMETHEUS_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/service-ca.crt
UPTIME_PROMETHEUS_INSECURE_SKIP_VERIFY=false
UPTIME_PROMETHEUS_TIMEOUT=10s
UPTIME_PROMETHEUS_RATE_WINDOW=5m
# UPTIME_BACKUP_DIR=/backup
UPTIME_BACKUP_INTERVAL=24h
# Size the backup volume for one copy more than kept: >= (keep + 1) x the
# database's size.
UPTIME_BACKUP_KEEP=7
# UPTIME_LICENSE_FILE=/etc/kubeat/license/license
UPTIME_LICENSE_RELOAD_INTERVAL=1m
# UPTIME_HEARTBEAT_URL=https://hc-ping.com/your-uuid
# Also the window kubeat_self_healthy judges the scheduler over, with or
# without a heartbeat URL.
UPTIME_HEARTBEAT_INTERVAL=1m
UPTIME_HEARTBEAT_TIMEOUT=10s
UPTIME_METRICS_TIMEOUT=5s
# UPTIME_SMTP_HOST=smtp.example.com
UPTIME_SMTP_PORT=587
# UPTIME_SMTP_FROM=Kubeat <kubeat@example.com>
UPTIME_SMTP_SECURITY=starttls
# UPTIME_SMTP_USERNAME=
# UPTIME_SMTP_PASSWORD=
UPTIME_TELEGRAM_API_URL=https://api.telegram.org
UPTIME_PAGERDUTY_EVENTS_URL=https://events.pagerduty.com/v2/enqueue

# Frontend
BACKEND_URL=http://localhost:8080
BACKEND_TIMEOUT_MS=3000
# The backend's UPTIME_FRONTEND_TOKEN, sent with every request to it; a header
# of that name from the browser is never passed on.
# FRONTEND_TOKEN=
# PUBLIC_URL=https://kubeat.apps.example
COOKIE_SECURE=auto
# STATUS_PAGE_FRAME_ANCESTORS=https://wiki.example.com
HSTS_MAX_AGE=31536000
REFRESH_INTERVAL_MS=5000
STATUS_PAGE_REFRESH_MS=30000
HISTORY_LIMIT=60
LIST_BEATS=24
WARN_UPTIME_BELOW=99.9
CRITICAL_UPTIME_BELOW=99
RESULTS_LIMIT=30
MONITOR_INCIDENTS=6
OVERVIEW_EVENTS=12
OVERVIEW_OUTAGES=5
FLAP_WINDOW=10m
FLEET_STRIP_HOURS=24
FLEET_STRIP_SLOTS=96
STATS_DAYS=7
NEW_MONITOR_INTERVAL_SECONDS=60
NEW_MONITOR_TIMEOUT_SECONDS=10
NEW_MONITOR_FAILURE_THRESHOLD=3
# PUSH_INTERNAL_URL=http://kubeat-backend.kubeat.svc:8080
INCIDENTS_LIMIT=100
INCIDENT_RANGES=24h,168h,720h,2160h
REPORT_PERIODS=30,1,7,90
AUDIT_LIMIT=200
UPTIME_WINDOWS=24h,168h,720h
CHART_RANGES=24h,1h,168h,720h
MAINTENANCE_DURATIONS=30m,1h,2h,4h,8h,24h
MAINTENANCE_LIMIT=50
DASHBOARD_FLAT_LIMIT=50
